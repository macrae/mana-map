{
  "extraKnownMarketplaces": {
    "mana-map": {
      "source": {
        "source": "directory",
        "path": "/Users/michellemacrae/mana-map/tools/claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "job-band@mana-map": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/python -I \"$CLAUDE_PROJECT_DIR\"/src/manamap/jobs.py hook"
          }
        ]
      }
    ]
  }
}
